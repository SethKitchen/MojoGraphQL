"""The 257 symbols, EOS last, in the order of their codes."""


@fieldwise_init
struct HuffmanDecoder(ImplicitlyCopyable, Movable):
    """The Huffman decoder. Its tables are constants, so it holds no state
    and costs nothing to make."""

    @always_inline
    def _code(self, acc: UInt64, shortest: Int) -> Tuple[Int, Int]:
        """Decode one code with the canonical search.

        Args:
            acc: The input bits, aligned left.
            shortest: The shortest length the code can have.

        Returns:
            The code length and the symbol.
        """
        var word = acc >> 32
        var limits = global_constant[_LIMIT]().unsafe_ptr()
        var length = shortest
        while word >= limits[unsafe_offset=length]:
            length += 1
        var first = global_constant[_FIRST]().unsafe_ptr()[unsafe_offset=length]
        var offset = global_constant[_OFFSET]().unsafe_ptr()[
            unsafe_offset=length
        ]
        var slot = Int(offset) + Int(
            (word >> UInt64(32 - length)) - UInt64(first)
        )
        var symbols = global_constant[_SYMBOLS]().unsafe_ptr()
        return (length, Int(symbols[unsafe_offset=slot]))

    def decode(self, data: Span[UInt8, _], mut out: List[UInt8]) -> Bool:
        """Append the bytes of a Huffman coded string to a buffer.

        Args:
            data: The code.
            out: The buffer; the bytes go at its end. On an error, its
                length is unchanged.

        Returns:
            False when the code has EOS, padding of 8 bits or more, or
            padding that is not all ones (RFC 7541 section 5.2).
        """
        var size = len(data)
        var source = data.unsafe_ptr()
        var start = len(out)
        # Every code is 5 bits or more. One more byte takes the second
        # byte that the fast path always writes.
        out.reserve(start + size * 8 // 5 + 1)
        var dst = out.unsafe_ptr()
        var written = start
        var fast = global_constant[_FAST]().unsafe_ptr()
        var acc: UInt64 = 0
        var bits = 0
        var position = 0
        while True:
            if position + 8 <= size:
                # Load 8 bytes, and count the whole bytes that fit. The
                # rest land below the count; the next load writes the same
                # bits over them.
                var word = byte_swap(
                    source.unsafe_offset(position)
                    .unsafe_bitcast[UInt64]()
                    .unsafe_load[alignment=1]()
                )
                acc |= word >> UInt64(bits)
                position += (63 - bits) >> 3
                bits |= 56
            else:
                while bits <= 56 and position < size:
                    var byte = UInt64(source[unsafe_offset=position])
                    acc |= byte << UInt64(56 - bits)
                    position += 1
                    bits += 8
            while bits >= FAST_BITS:
                var entry = fast[unsafe_offset=Int(acc >> 52)]
                var count = Int((entry >> 16) & 0xFF)
                if count == 0:
                    # The longest code is 30 bits: load more first.
                    if bits < EOS_LENGTH and position < size:
                        break
                    var length, symbol = self._code(acc, FAST_BITS + 1)
                    if length > bits or symbol == EOS:
                        return False
                    dst[unsafe_offset=written] = UInt8(symbol)
                    written += 1
                    acc <<= UInt64(length)
                    bits -= length
                else:
                    dst.unsafe_offset(written).unsafe_bitcast[
                        UInt16
                    ]().unsafe_store[alignment=1](
                        (entry & 0xFFFF).cast[DType.uint16]()
                    )
                    written += count
                    var consumed = Int(entry >> 24)
                    acc <<= UInt64(consumed)
                    bits -= consumed
            if position >= size:
                break
        # The input is done, and fewer than 12 bits are left.
        while bits > 0:
            var ones = (UInt64(1) << UInt64(bits)) - 1
            if bits < 8 and (acc >> UInt64(64 - bits)) == ones:
                break
            var length, symbol = self._code(acc, 5)
            if length > bits:
                return False
            dst[unsafe_offset=written] = UInt8(symbol)
            written += 1
            acc <<= UInt64(length)
            bits -= length
        out.resize(unsafe_uninit_length=written)
        return True


def huffman_decode(data: Span[UInt8, _], mut out: List[UInt8]) -> Bool:
    """Append the bytes of a Huffman coded string to a buffer.

    This builds the tables for each call. A decoder of many strings holds
    one `HuffmanDecoder` instead.

    Args:
        data: The code.
        out: The buffer; the bytes go at its end.

    Returns:
        False when the code is not valid; see `HuffmanDecoder.decode`.
    """
    return HuffmanDecoder().decode(data, out)
