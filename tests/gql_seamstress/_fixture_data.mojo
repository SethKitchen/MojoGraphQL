def fixture_paths() -> List[String]:
    """Return the path of each file, from `fixtures/`."""
    var out = List[String]()
    out.append(_path_0())
    out.append(_path_1())
    out.append(_path_2())
    out.append(_path_3())
    out.append(_path_4())
    out.append(_path_5())
    out.append(_path_6())
    out.append(_path_7())
    return out^


def fixture_text(path: StringSlice) raises -> String:
    """Return the text of a file of `fixtures/`."""
    if path == _path_0():
        return _file_0()
    if path == _path_1():
        return _file_1()
    if path == _path_2():
        return _file_2()
    if path == _path_3():
