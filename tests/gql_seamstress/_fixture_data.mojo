def _file_3() -> String:
    var out = String()
    out += '"""The `Upload` scalar type represents a file upload.""'
    out += '"\nscalar Upload\n\ntype Query {\n  """A simple type for'
    out += ' getting started!"""\n  hello: String\n  cats(cat: [Strin'
    out += 'g]! = ["Nori"]): [String]!\n  dogs(\n    excludeChihuahuas'
    out += ': Boolean = false @deprecated(reason: "Chihuahuas are dogs '
    out += 'too!"),\n  ): [String]!\n}\n\nenum CacheControlScope {\n  P'
    out += "UBLIC\n  PRIVATE\n}\n\ninput BooleanQueryOperatorInput {\n  "
    out += "eq: Boolean\n  ne: Boolean\n  in: [Boolean]\n  nin: [Boolean"
    out += "]\n}\n\ninput StringQueryOperatorInput {\n  eq: String\n  ne"
    out += ": String\n  in: [String]\n  nin: [String]\n  regex: String\n"
    out += '  glob: String @deprecated(reason: "Glob is deprecated, use'
    out += ' regex instead")\n}\n\ndirective @cacheControl(maxAge: Int,'
    out += " scope: CacheControlScope) on FIELD_DEFINITION | OBJECT | IN"
    out += 'TERFACE\n\n"""Exposes a URL that specifies the behaviour '
    out += 'of this scalar."""\ndirective @specifiedBy(\n  """The '
    out += 'URL that specifies the behaviour of this scalar."""\n  ur'
    out += "l: String!,\n) on SCALAR\n"
    return out^


