def _file_1() -> String:
    var out = String()
    out += 'type Query {\n  """Fetch a simple list of products with a'
    out += 'n offset"""\n  topProducts(first: Int = 5): [Product] @de'
    out += 'precated(reason: "Use `products` instead")\n  """Fetch '
    out += 'a paginated list of products based on a filter type."""\n'
    out += "  products(first: Int = 5, after: Int = 0, type: ProductType"
    out += '): ProductConnection\n  """\n  The currently authenticate'
    out += "d user root. All nodes off of this\n  root will be authentic"
    out += 'ated as the current user\n  """\n  me: User\n}\n\n"""A'
    out += ' review is any feedback about products across the graph""'
    out += '"\ntype Review {\n  id: ID!\n  """The plain text version'
    out += ' of the review"""\n  body: String\n  """The user who a'
    out += 'uthored the review"""\n  author: User\n  """The produc'
    out += 't which this review is about"""\n  product: Product\n}\n'
    out += '\n"""The base User in Acephei"""\ntype User {\n  ""'
    out += '"A globally unique id for the user"""\n  id: ID!\n  ""'
    out += '"The users full name as provided"""\n  name: String\n  '
    out += '"""The account username of the user"""\n  username: St'
    out += 'ring\n  """A list of all reviews by the user"""\n  rev'
    out += 'iews: [Review]\n}\n\n"""A connection wrapper for lists of'
    out += ' reviews"""\ntype ReviewConnection {\n  """Helpful met'
    out += 'adata about the connection"""\n  pageInfo: PageInfo\n  "'
    out += '""List of reviews returned by the search"""\n  edges: ['
    out += 'ReviewEdge]\n}\n\n"""\nThe PageInfo type provides paginat'
    out += "ion helpers for determining\nif more data can be fetched fro"
    out += 'm the list\n"""\ntype PageInfo {\n  """More items exis'
    out += 't in the list"""\n  hasNextPage: Boolean\n  """Items e'
    out += 'arlier in the list exist"""\n  hasPreviousPage: Boolean\n'
    out += '}\n\n"""A connection edge for the Review type"""\ntype'
    out += ' ReviewEdge {\n  review: Review\n}\n\n"""A connection wra'
    out += 'pper for lists of products"""\ntype ProductConnection {\n'
    out += '  """Helpful metadata about the connection"""\n  pageI'
    out += 'nfo: PageInfo\n  """List of products returned by the sear'
    out += 'ch"""\n  edges: [ProductEdge]\n}\n\n"""A connection ed'
    out += 'ge for the Product type"""\ntype ProductEdge {\n  product'
    out += ': Product\n}\n\n"""The basic book in the graph"""\ntyp'
    out += 'e Book implements Product {\n  """All books can be found '
    out += 'by an isbn"""\n  isbn: String!\n  """The title of the '
    out += 'book"""\n  title: String\n  """The year the book was p'
    out += 'ublished"""\n  year: Int\n  """\n  Улюблена к'
    out += 'нига, прочитана цього рока "" | 今'
    out += '年読んだお気に入りの本\n  """\n  favouriteBook'
    out += ': Book\n  """A simple list of similar books"""\n  simi'
    out += "larBooks: [Book]\n  reviews: [Review]\n  reviewList(first: I"
    out += 'nt = 5, after: Int = 0): ReviewConnection\n  """\n  relat'
    out += "edReviews for a book use the knowledge of `similarBooks` fro"
    out += "m the books\n  service to return related reviews that may be"
    out += ' of interest to the user\n  """\n  relatedReviews(first: '
    out += 'Int = 5, after: Int = 0): ReviewConnection\n  """\n  Sinc'
    out += "e books are now products, we can also use their upc as a pri"
    out += 'mary id\n  """\n  upc: String!\n  """The name of a boo'
    out += 'k is the book\'s title + year published"""\n  name(delimet'
    out += 'er: String = " "): String\n  price: Int\n  weight: Int\n}'
    out += '\n\n"""Information about the brand Amazon"""\ntype Ama'
    out += 'zon {\n  """The url of a referrer for a product"""\n  '
    out += 'referrer: String\n}\n\n"""Information about the brand Ike'
    out += 'a"""\ntype Ikea {\n  """Which asile to find an item"'
    out += '""\n  asile: Int\n}\n\n"""\nThe Furniture type represen'
    out += 'ts all products which are items\nof furniture.\n"""\ntype'
    out += ' Furniture implements Product {\n  """The modern primary '
    out += 'identifier for furniture"""\n  upc: String!\n  """\n  '
    out += "The SKU field is how furniture was previously stored, and st"
    out += 'ill exists in some legacy systems\n  """\n  sku: String!'
    out += '\n  name: String\n  price: Int\n  """The brand of furnitu'
    out += 're"""\n  brand: Brand\n  weight: Int\n  reviews: [Review]'
    out += "\n  reviewList(first: Int = 5, after: Int = 0): ReviewConnec"
    out += 'tion\n}\n\n"""The Product type represents all products wi'
    out += 'thin the system"""\ninterface Product {\n  """The prim'
    out += 'ary identifier of products in the graph"""\n  upc: String'
    out += '!\n  """The display name of the product"""\n  name: St'
    out += 'ring\n  """A simple integer price of the product in US do'
    out += 'llars"""\n  price: Int\n  """How much the product weig'
    out += 'hs in kg"""\n  weight: Int @deprecated(reason: "Not all '
    out += 'product\'s have a weight")\n  """A simple list of all rev'
    out += 'iews for a product"""\n  reviews: [Review] @deprecated(re'
    out += 'ason: "The `reviews` field on product is deprecated to roll'
    out += " over the return\\ntype from a simple list to a paginated li"
    out += "st. The easiest way to fix your\\noperations is to alias the"
    out += " new field `reviewList` to `review`.\\nOnce all clients have"
    out += " updated, we will roll over this field and deprecate\\n`revi"
    out += 'ewList` in favor of the field name `reviews` again")\n  "'
    out += '""\n  A paginated list of reviews. This field naming is te'
    out += "mporary while all clients\n  migrate off of the un-paginated"
    out += " version of this field call reviews. To ease this migration,"
    out += "\n  alias your usage of `reviewList` to `reviews` so that af"
    out += "ter the roll over is finished, you\n  can remove the alias a"
    out += 'nd use the final field name.\n  """\n  reviewList(first: '
    out += 'Int = 5, after: Int = 0): ReviewConnection\n}\n\n"""A uni'
    out += 'on of all brands represented within the store"""\nunion B'
    out += 'rand = Ikea | Amazon\n\n"""An enum of product types"""'
    out += "\nenum ProductType {\n  LATEST\n  TRENDING\n}\n"
    return out^


