"""Tests for `introspection_from_schema`, ported from graphql-js 16.14.2
`src/utilities/__tests__/introspectionFromSchema-test.ts`.

Upstream prints the schema that `buildClientSchema` makes from the
result. This port compares the result itself with the JSON of graphql-js
16.14.2 `introspectionFromSchema` for the same schema, which is a
stronger check of the same data; `test_build_client_schema.mojo` checks
the round trip.

Upstream cases that are not ported:

- `includes deprecated directives`: a deprecated directive cannot be
  written in SDL.
"""

from std.testing import TestSuite, assert_equal, assert_true
from gql_execution.introspection import (
    IntrospectionOptions,
    introspection_from_schema,
)
from gql_json.writer import stringify
from gql_schema.build import build_schema

comptime SDL = '''"""This is a simple schema"""
schema {
  query: Simple
}

"""This is a simple type"""
type Simple {
  """This is a string field"""
  string: String
}
'''


def test_converts_a_simple_schema() raises:
    var data = introspection_from_schema(build_schema(SDL))
    assert_equal(stringify(data, data.root), WITH_DESCRIPTIONS)


def test_converts_a_simple_schema_without_descriptions() raises:
    var options = IntrospectionOptions.all()
    options.descriptions = False
    var data = introspection_from_schema(build_schema(SDL), options)
    assert_equal(stringify(data, data.root), WITHOUT_DESCRIPTIONS)


def test_a_failed_introspection_raises() raises:
    var schema = build_schema("type Query { f(a: Float = 1e400): String }")
    var raised = False
    try:
        _ = introspection_from_schema(schema)
    except e:
        raised = True
        assert_equal(
            String(e), "Unexpected error: the introspection query failed."
        )
    assert_true(raised)


